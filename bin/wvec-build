#!/usr/bin/env bash
#
# WorldVistA Engineering Console
# Build Utility
# Version 1.1
#

set -euo pipefail

WVEC_ROOT="$HOME/wvec"
SRC="$WVEC_ROOT/src/routines"
DST="$HOME/wvbuild/VistA-Source/r"

MODE="${1:-build}"

banner() {
    echo
    echo "======================================================"
    echo "        WVEC Build Utility  Version 1.1"
    echo "======================================================"
    echo
}

verify() {

    banner

    echo "Verifying installed routines..."
    echo

    total=0
    missing=0

    for routine in "$SRC"/*.m
    do
        [ -f "$routine" ] || continue

        base=$(basename "$routine")
        total=$((total+1))

        printf "%-20s " "$base"

        if [ -f "$DST/$base" ]; then
            echo "OK"
        else
            echo "MISSING"
            missing=$((missing+1))
        fi
    done

    echo
    echo "======================================================"
    echo "Verification Summary"
    echo "======================================================"
    echo "Verified : $total routine(s)"
    echo "Missing  : $missing"
    echo

    if [ "$missing" -eq 0 ]; then
        echo "Verification successful."
    else
        echo "Verification failed."
    fi

    echo "======================================================"
}

build() {

    banner

    echo "Source      : $SRC"
    echo "Destination : $DST"
    echo

    count=0
    errors=0

    total=$(find "$SRC" -maxdepth 1 -name "*.m" | wc -l)

    for routine in "$SRC"/*.m
    do
        [ -f "$routine" ] || continue

        count=$((count+1))

        base=$(basename "$routine")
        expected="${base%.m}"

        printf "[%d/%d] %-20s " "$count" "$total" "$base"

        if grep -q '^```' "$routine"; then
            echo "FAILED"
            exit 1
        fi

        first=$(head -1 "$routine")

        case "$first" in
            "$expected "*|"$expected;"*)
                ;;
            *)
                echo "FAILED"
                echo
                echo "ERROR: First line does not begin with '$expected'"
                exit 1
                ;;
        esac

        cp "$routine" "$DST/$base"

        echo "OK"
    done

    echo
    echo "======================================================"
    echo "Build Summary"
    echo "======================================================"
    echo "Installed : $count routine(s)"
    echo "Errors    : $errors"
    echo
    echo "Build completed successfully."
    echo "======================================================"
}

case "$MODE" in
    build)
        build
        ;;
    verify)
        verify
        ;;
    *)
        echo
        echo "Usage:"
        echo "  wvec-build"
        echo "  wvec-build build"
        echo "  wvec-build verify"
        exit 1
        ;;
esac
