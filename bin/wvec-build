#!/usr/bin/env bash
#
# WVEC Build Utility
#

set -e

# ------------------------------------------------------------------
# Ensure YottaDB environment is loaded
# ------------------------------------------------------------------

if [[ -z "$ydb_dist" ]]; then
    source /usr/local/lib/yottadb/r206/ydb_env_set
fi

WVEC_HOME="$HOME/wvec"
SRC_DIR="$WVEC_HOME/src/routines"
DST_DIR="$HOME/wvbuild/VistA-Source/r"

source "$WVEC_HOME/lib/compiler.sh"

PASS=0
FAIL=0

echo
echo "=========================================="
echo "      WVEC Build Utility"
echo "=========================================="
echo

mkdir -p "$DST_DIR"

for routine in "$SRC_DIR"/*.m
do
    [ -f "$routine" ] || continue

    name=$(basename "$routine")

    cp "$routine" "$DST_DIR/$name"

    printf "Installing %-20s " "$name"
    echo "OK"

    if compile_routine "$DST_DIR/$name"
    then
        PASS=$((PASS+1))
    else
        FAIL=$((FAIL+1))
    fi
done

echo
echo "=========================================="
echo "Build Summary"
echo "=========================================="
echo "Compiled : $PASS"
echo "Failed   : $FAIL"
echo

if [ "$FAIL" -eq 0 ]; then
    echo "BUILD STATUS : VERIFIED"
    echo
    echo "NOTE:"
    echo "Restart YottaDB (H and restart) before testing newly compiled routines."
    exit 0
else
    echo "BUILD STATUS : FAILED"
    exit 1
fi
