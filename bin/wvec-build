#!/usr/bin/env bash
#
# WorldVistA Engineering Console
# Build Utility
# Version 1.0
#

set -euo pipefail

WVEC_ROOT="$HOME/wvec"
SRC="$WVEC_ROOT/src/routines"
DST="$HOME/wvbuild/VistA-Source/r"

echo
echo "======================================================"
echo "        WVEC Build Utility  Version 1.0"
echo "======================================================"
echo
echo "Source      : $SRC"
echo "Destination : $DST"
echo

count=0
errors=0

total=$(find "$SRC" -maxdepth 1 -name "*.m" | wc -l)

for routine in "$SRC"/*.m
do
    [ -f "$routine" ] || continue

    count=$((count+1))

    base=$(basename "$routine")
    expected="${base%.m}"

    printf "[%d/%d] %-20s " "$count" "$total" "$base"

    #
    # Reject Markdown code fences
    #
    if grep -q '^```' "$routine"; then
        echo "FAILED"
        echo
        echo "ERROR: Markdown code fence found in $base"
        exit 1
    fi

    #
    # Verify first line begins with the routine name
    #
    first=$(head -1 "$routine")

    case "$first" in
        "$expected "*|"$expected;"*)
            ;;
        *)
            echo "FAILED"
            echo
            echo "ERROR: First line of $base does not begin with '$expected'"
            echo "Found: $first"
            exit 1
            ;;
    esac

    cp "$routine" "$DST/$base"

    echo "OK"
done

echo
echo "======================================================"
echo "Build Summary"
echo "======================================================"
echo "Installed : $count routine(s)"
echo "Errors    : $errors"
echo
echo "Build completed successfully."
echo "======================================================"
