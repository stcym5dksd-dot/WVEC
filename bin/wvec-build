#!/bin/bash
#
# wvec-build
# WorldVistA Engineering Console Build Utility
#

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

SRC="$ROOT/src/routines"
DEST="$HOME/wvbuild/VistA-Source/r"
REPORTDIR="$ROOT/reports"

source "$ROOT/lib/environment.sh"
source "$ROOT/lib/compiler.sh"
source "$ROOT/lib/validator.sh"

MODE="${1:-build}"

#
# Initialize the WVEC environment
#
if ! wvec_init
then
    echo
    echo "WVEC initialization failed."
    exit 1
fi

build() {

    copied=0
    compiled=0
    failed=0
    validated=0

    echo "=========================================="
    echo "      WVEC Build Utility"
    echo "=========================================="
    echo

    mkdir -p "$DEST"
    mkdir -p "$REPORTDIR"

    for src in "$SRC"/*.m
    do
        [ -f "$src" ] || continue

        name=$(basename "$src")

        printf "%-20s" "$name"

        #
        # Validate routine
        #
        if ! validate_routine "$src"
        then
            echo "VALIDATION FAILED"
            ((failed++))
            continue
        fi

        ((validated++))

        #
        # Copy routine
        #
        cp "$src" "$DEST/$name"

        if [ $? -ne 0 ]
        then
            echo "COPY FAILED"
            ((failed++))
            continue
        fi

        echo "INSTALLED"
        ((copied++))

        #
        # Compile installed routine
        #
        if compile_routine "$DEST/$name"
        then
            ((compiled++))
        else
            ((failed++))
        fi

    done

    echo
    echo "=========================================="
    echo "WVEC BUILD REPORT"
    echo "=========================================="

    printf "Validated  : %d\n" "$validated"
    printf "Copied     : %d\n" "$copied"
    printf "Compiled   : %d\n" "$compiled"
    printf "Failed     : %d\n" "$failed"

    MANIFEST="$REPORTDIR/build-manifest.txt"

    {
        echo "=========================================="
        echo "WVEC Build Manifest"
        echo "=========================================="
        echo
        echo "Date       : $(date)"
        echo "Branch     : $(git branch --show-current)"
        echo "Commit     : $(git rev-parse --short HEAD)"
        echo
        echo "Validated  : $validated"
        echo "Copied     : $copied"
        echo "Compiled   : $compiled"
        echo "Failed     : $failed"
        echo
        echo "Routines"
        echo "--------"

        for src in "$SRC"/*.m
        do
            basename "$src" .m
        done

        echo
        if [ "$failed" -eq 0 ]
        then
            echo "Status     : VERIFIED"
        else
            echo "Status     : FAILED"
        fi

    } > "$MANIFEST"

    echo
    echo "Build manifest written to:"
    echo "  $MANIFEST"

    echo

    if [ "$failed" -eq 0 ]
    then
        echo "BUILD STATUS : VERIFIED"
    else
        echo "BUILD STATUS : FAILED"
        return 1
    fi
}

verify() {

    echo "=========================================="
    echo "WVEC Verification"
    echo "=========================================="
    echo

    missing=0

    for src in "$SRC"/*.m
    do
        [ -f "$src" ] || continue

        name=$(basename "$src")

        if [ -f "$DEST/$name" ]
        then
            printf "%-20s INSTALLED\n" "$name"
        else
            printf "%-20s MISSING\n" "$name"
            ((missing++))
        fi
    done

    echo

    if [ "$missing" -eq 0 ]
    then
        echo "Verification successful."
    else
        echo "$missing routine(s) missing."
        return 1
    fi
}

case "$MODE" in
    build)
        build
        ;;
    verify)
        verify
        ;;
    *)
        echo "Usage:"
        echo "  wvec-build"
        echo "  wvec-build build"
        echo "  wvec-build verify"
        exit 1
        ;;
esac
