#!/usr/bin/env bash
# WVEC Browser Edition
# Reserved for browser users
# Developer launcher remains: ~/WVEC/bin/wvec
#
# WorldVistA Extended Engineering Console
# WVEC-H1: Browser users must never see YDB>
#

clear

source "$HOME/wvec/lib/common.sh"
source "$HOME/wvec/lib/bootstrap.sh"
source "$HOME/wvec/lib/checks.sh"
source "$HOME/wvec/lib/dashboard.sh"
source "$HOME/wvec/lib/taskman.sh"
source "$HOME/wvec/lib/kernel.sh"
source "$HOME/wvec/lib/git.sh"
source "$HOME/wvec/lib/doctor.sh"
source "$HOME/wvec/lib/live.sh"
source "$HOME/wvec/lib/workbench.sh"

#
# Initialize WVEC
#
wvec_bootstrap || {
    echo
    echo "ERROR: Unable to initialize WVEC."
    exit 1
}

while true
do
    clear

    echo
    echo "Starting WVEC..."
    echo

    "$ydb_dist/mumps" -run WVEC

    echo
    read -p "Restart WVEC? (Y/N): " ans

    case "$ans" in
        Y|y) ;;
        *) break ;;
    esac
done
